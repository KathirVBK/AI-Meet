# ============================================================
# AI Meeting Assistant — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your keys as needed.
# The speaker-identification pipeline will gracefully degrade
# if Pyannote / HuggingFace tokens are missing — it will fall
# back to WhisperX inline diarization, then to Faster-Whisper,
# then to Groq Whisper (text-only single-speaker mode).
# ============================================================


# ------------------------------------------------------------
# 1. LLM (MUST-HAVE) — used for summarisation and task extraction
# ------------------------------------------------------------
# Groq API Key — free tier available. Sign up at https://console.groq.com/
GROQ_API_KEY=


# ------------------------------------------------------------
# 2. Speech-to-Text Backend (RECOMMENDED for speaker features)
# ------------------------------------------------------------
# Controls which ASR + alignment engine is used by transcript_service.
# Valid values:
#   "auto"           -> picks the best available: whisperx > faster_whisper > groq
#   "whisperx"       -> WhisperX (ASR + forced word alignment + optional inline diarization)
#   "faster_whisper" -> Faster-Whisper (local CPU/GPU, no forced alignment)
#   "groq"           -> Groq cloud Whisper (fast & cheap, text-only, NO timestamps)
#
# For the speaker pipeline to work you want "auto" or "whisperx" so that
# word-level timestamps can be aligned to the diarization segments.
STT_BACKEND=auto

# Size of the Whisper model to load for whisperx / faster_whisper.
# Options: tiny / base / small / medium / large-v2 / large-v3
# Use "large-v3" for best transcription accuracy (requires more RAM).
WHISPER_MODEL_SIZE=large-v3

# Split long recordings into smaller chunks so meetings longer than 10 minutes
# can still be processed reliably. The value is in minutes.
AUDIO_CHUNK_DURATION_MINUTES=8

# Node proxy timeout for long audio processing jobs (milliseconds).
AUDIO_PROCESS_TIMEOUT_MS=3600000

# WhisperX / Faster-Whisper compute type.
# GPU:   "float16"  (fastest — requires CUDA 11.8+)
# CPU:   "int8"     (best CPU speed/accuracy trade-off)
# MPS:   "float16"  (Apple Silicon)
STT_COMPUTE_TYPE=int8


# ------------------------------------------------------------
# 3. Speaker Diarization (REQUIRED for Speaker 1/2/3 labelling)
# ------------------------------------------------------------
# Pyannote Audio v3.1 requires TWO one-time steps (FREE, open-source):
#
#   Step 1 — get a HuggingFace token:
#       https://huggingface.co/settings/tokens  (READ access is enough)
#
#   Step 2 — accept the license for BOTH gated models (same account):
#       https://huggingface.co/pyannote/speaker-diarization-3.1
#       https://huggingface.co/pyannote/segmentation-3.0
#
# Then paste your token below. Any of the three variable names works.
HF_TOKEN=
HUGGINGFACE_TOKEN=
PYANNOTE_AUTH_TOKEN=

# If you already know how many speakers are in a meeting, you can
# hard-code it here for better accuracy. Leave 0 = auto-detect.
DEFAULT_NUM_SPEAKERS=0


# ------------------------------------------------------------
# 4. Vector database path (storage for LLM chat history)
# ------------------------------------------------------------
CHROMA_DB_PATH=./chroma_db


# ------------------------------------------------------------
# 5. Backend host/ports (optional)
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=5000
